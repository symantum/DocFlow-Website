ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://docflow_onboarding:change-me@localhost:5432/docflow_onboarding
AUTO_CREATE_TABLES=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PUBLIC_WEBSITE_URL=http://localhost:5173

# Use local outbox until the provider account is created.
EMAIL_PROVIDER=outbox
EMAIL_FROM=DocFlow by Symantum <onboarding@localhost>
INTERNAL_NOTIFICATION_EMAIL=onboarding@localhost
POSTMARK_SERVER_TOKEN=

# Use disabled only in local development. Production startup rejects this.
BOT_PROVIDER=disabled
TURNSTILE_SECRET_KEY=

# Generate separate random values for deployed environments.
APP_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=replace-with-a-different-32-character-secret
CONSENT_VERSION=2026-09-17
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=3600
