# Public intake API (first release: bundled on AP Portal).
# Never put INTERNAL_API_KEY, DB passwords, or Turnstile secret in Vite env.
VITE_ONBOARDING_API_URL=https://api.ap.symantum.com/onboarding

# Cloudflare Turnstile site key (public). Leave unset until widget is created.
# VITE_TURNSTILE_SITE_KEY=

# Local against a laptop onboarding process instead:
# VITE_ONBOARDING_API_URL=http://127.0.0.1:8010
